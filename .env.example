# MediKiosk environment variables
# Copy this file to .env and fill in your Supabase & Gemini API values.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Gemini API Key (for dynamic clinical interview, prescription OCR, & summary)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
